{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meus-agentes/relatorio@1",
  "title": "Relatório de auditoria (meus-agentes)",
  "type": "object",
  "required": ["schema", "agente", "tipo", "escopo", "data", "resumo", "achados", "fora_do_escopo", "limitacoes", "comparacao"],
  "properties": {
    "schema": { "const": "meus-agentes/relatorio@1" },
    "agente": { "enum": ["finops-azure", "finops-maturidade", "azure-architect", "cloud-security-analyst", "k8s-auditor", "log-hunter"] },
    "skill": { "type": "string" },
    "tipo": { "enum": ["finops", "finops-maturidade", "arch", "security", "k8s", "logs"] },
    "escopo": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "contexto": { "type": "object" },
    "resumo": {
      "type": "object",
      "required": ["critico", "alto", "medio", "baixo", "info"],
      "properties": {
        "critico": { "type": "integer", "minimum": 0 }, "alto": { "type": "integer", "minimum": 0 },
        "medio": { "type": "integer", "minimum": 0 }, "baixo": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }, "destaque": { "type": ["string", "null"] }
      }
    },
    "achados": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fingerprint", "titulo", "severidade", "confianca", "evidencia", "recomendacao"],
        "properties": {
          "id": { "type": "string" },
          "fingerprint": { "type": "string", "pattern": "^[^A-Z]+\\|.+$" },
          "titulo": { "type": "string" },
          "categoria": { "type": "string" },
          "recurso": { "type": "string" },
          "ambiente": { "enum": ["Produção", "Não Produção", "Não identificado", null] },
          "severidade": { "enum": ["Crítico", "Alto", "Médio", "Baixo", "Info"] },
          "confianca": { "enum": ["Confirmado", "Potencial", "Inconclusivo"] },
          "evidencia": { "type": "string" },
          "recomendacao": { "type": "string" },
          "economia_mensal_usd": { "type": ["number", "null"] }
        }
      }
    },
    "fora_do_escopo": { "type": "array", "items": { "type": "object", "required": ["agente", "item"] } },
    "limitacoes": { "type": "array", "items": { "type": "string" } },
    "comparacao": {
      "type": "object",
      "required": ["relatorio_anterior", "novos", "resolvidos", "persistentes"],
      "properties": {
        "relatorio_anterior": { "type": ["string", "null"] },
        "novos": { "type": "array" }, "resolvidos": { "type": "array" }, "persistentes": { "type": "array" },
        "pioraram": { "type": "array" }, "melhoraram": { "type": "array" }
      }
    }
  }
}
